HOST_PORT=8085

AI_DB_URL=jdbc:postgresql://ai-db:5432/ai_db
AI_DB_USER=ai
AI_DB_PASSWORD=

# Gọi catalog qua tên service trong mạng Docker
CATALOG_URL=http://catalog-service:8084

EUREKA_ENABLED=false
EUREKA_URL=http://eureka-server:8761/eureka/

JWT_ISSUER=http://localhost:8081
JWT_JWK_SET_URI=http://host.docker.internal:8081/.well-known/jwks.json
JWT_AUDIENCE=bookstore

GEMINI_API_KEY=
GEMINI_MODEL=
# Enable local API documentation; disable in production.
SWAGGER_ENABLED=true

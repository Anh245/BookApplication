# ====================================
# Environment Variables Configuration
# ====================================
# Copy file này thành .env và điền giá trị thực
# File .env đã được thêm vào .gitignore, KHÔNG bị push lên GitHub

# Server Port
SERVER_PORT=8081

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=QLBookStore
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_THIS_PASSWORD

# JWT Configuration
# RSA PEM files: see ../docs/jwt-contract.md. Keep the private key only on UserServices.
JWT_PRIVATE_KEY_PATH=C:/path/to/jwt-private.pem
JWT_PUBLIC_KEY_PATH=C:/path/to/jwt-public.pem
JWT_KEY_ID=bookstore-1
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=bookstore
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Admin Default Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
ADMIN_EMAIL=admin@bookstore.com

# SMTP is required outside dev. Configure a real provider; never commit its credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
# Only for intentional simulation: SPRING_PROFILES_ACTIVE=dev

# Allowed browser origins for local frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173,http://127.0.0.1:5173

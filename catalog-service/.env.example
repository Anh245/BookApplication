# Cổng truy cập từ máy Windows
HOST_PORT=8084

# Database trong mạng Docker
CATALOG_DB_URL=jdbc:postgresql://catalog-db:5432/catalog_db
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=

# Tắt discovery khi chạy thử riêng service
EUREKA_ENABLED=false
EUREKA_URL=http://eureka-server:8761/eureka/

# Thay theo cấu hình user-service của BE1
JWT_ISSUER=http://localhost:8081
JWT_JWK_SET_URI=http://host.docker.internal:8081/.well-known/jwks.json
JWT_AUDIENCE=bookstore
# Enable local API documentation; disable in production.
SWAGGER_ENABLED=true
